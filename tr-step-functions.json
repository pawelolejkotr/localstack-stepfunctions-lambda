{
  "StartAt": "CheckConcurrency",
  "States": {
    "CheckConcurrency": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.max_concurrency",
          "IsPresent": true,
          "Next": "PrepareStep"
        }
      ],
      "Default": "SetDefaultConcurrency"
    },
    "SetDefaultConcurrency": {
      "Type": "Pass",
      "Result": 5,
      "ResultPath": "$.max_concurrency",
      "Next": "PrepareStep"
    },
    "PrepareStep": {
      "Next": "ProcessChunksLoop",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "TimeoutSeconds": 900,
      "ResultPath": "$.PrepareResult",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:gto-logic",
        "Payload": {
          "mode": "prepare",
          "customer_tenant_system_name.$": "$.customer_tenant_system_name",
          "chunk_size.$": "$.chunk_size",
          "execution_identification.$": "$.execution_identification",
          "tenant_identification.$": "$.tenant_identification",
          "requested_by.$": "$.requested_by"
        }
      }
    },
    "ProcessChunksLoop": {
      "Type": "Map",
      "ResultPath": "$.ProcessResults",
      "Next": "AggregateStep",
      "MaxConcurrencyPath": "$.max_concurrency",
      "Parameters": {
        "ChunkData.$": "$$.Map.Item.Value",
        "GlobalInput.$": "$",
        "GeneratedToken.$": "$.PrepareResult.Payload.uds_long_token"
      },
      "ItemsPath": "$.PrepareResult.Payload.chunks",
      "Iterator": {
        "StartAt": "CheckType",
        "States": {
          "CheckType": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.ChunkData.t",
                "IsPresent": true,
                "Next": "ProcessChunk"
              }
            ],
            "Default": "SkipChunk"
          },
          "SkipChunk": {
            "Type": "Pass",
            "Result": {
              "skipped": true
            },
            "End": true
          },
          "ProcessChunk": {
            "Type": "Task",
            "End": true,
            "TimeoutSeconds": 900,
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "ChunkError",
                "ResultPath": "$.ErrorDetails"
              }
            ],
            "OutputPath": "$.Payload",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:gto-logic",
              "Payload": {
                "mode": "process",
                "type.$": "$.ChunkData.t",
                "items.$": "$.ChunkData.its",
                "customer_tenant_system_name.$": "$.GlobalInput.customer_tenant_system_name",
                "uds_long_token.$": "$.GeneratedToken",
                "execution_identification.$": "$.GlobalInput.execution_identification",
                "tenant_identification.$": "$.GlobalInput.tenant_identification",
                "requested_by.$": "$.GlobalInput.requested_by"
              }
            }
          },
          "ChunkError": {
            "Type": "Pass",
            "End": true,
            "Parameters": {
              "status": "failed",
              "error_message.$": "$.ErrorDetails.Cause",
              "chunk_info.$": "$.ChunkData"
            }
          }
        }
      }
    },
    "AggregateStep": {
      "Next": "FinalSummary",
      "Type": "Task",
      "TimeoutSeconds": 900,
      "ResultPath": "$.AggregateResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:gto-logic",
        "Payload": {
          "mode": "aggregate",
          "customer_tenant_system_name.$": "$.customer_tenant_system_name",
          "process_results.$": "$.ProcessResults",
          "uds_long_token.$": "$.PrepareResult.Payload.uds_long_token",
          "execution_identification.$": "$.execution_identification",
          "tenant_identification.$": "$.tenant_identification",
          "requested_by.$": "$.requested_by"
        }
      }
    },
    "FinalSummary": {
      "Type": "Pass",
      "End": true,
      "Parameters": {
        "RunConfig": {
          "MaxConcurrencyUsed.$": "$.max_concurrency",
          "ChunkSize.$": "$.chunk_size"
        },
        "Step1_Prepare": {
          "LambdaOutput.$": "$.PrepareResult.Payload"
        },
        "Step2_Process": {
          "Results.$": "$.ProcessResults"
        },
        "Step3_Aggregate": {
          "LambdaOutput.$": "$.AggregateResult.Payload"
        }
      }
    }
  }
}