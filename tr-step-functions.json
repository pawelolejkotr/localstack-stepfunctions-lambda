{
  "Comment": "Wersja z pelnym raportowaniem kontekstu w kazdym kroku",
  "StartAt": "PrepareStep",
  "States": {
    "PrepareStep": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:gto-logic",
        "Payload": {
          "mode": "prepare",
          "customer_tenant_system_name.$": "$.customer_tenant_system_name",
          "chunk_size.$": "$.chunk_size",
          "execution_identification.$": "$.execution_identification",
          "tenant_identification.$": "$.tenant_identification",
          "requested_by.$": "$.requested_by"
        }
      },
      "ResultPath": "$.PrepareResult",
      "Next": "ProcessChunksLoop"
    },
    "ProcessChunksLoop": {
      "Type": "Map",
      "ItemsPath": "$.PrepareResult.Payload.chunks",
      "ResultPath": "$.ProcessResults",
      "Parameters": {
        "ChunkData.$": "$$.Map.Item.Value",
        "GlobalInput.$": "$",
        "GeneratedToken.$": "$.PrepareResult.Payload.uds_long_token"
      },
      "Iterator": {
        "StartAt": "CheckType",
        "States": {
          "CheckType": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.ChunkData.type",
                "StringEqualsPath": "$.GlobalInput.type",
                "Next": "ProcessChunk"
              }
            ],
            "Default": "SkipChunk"
          },
          "ProcessChunk": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:gto-logic",
              "Payload": {
                "mode": "process",
                "type.$": "$.ChunkData.type",
                "items.$": "$.ChunkData.items",
                "customer_tenant_system_name.$": "$.GlobalInput.customer_tenant_system_name",
                "uds_long_token.$": "$.GeneratedToken",
                "execution_identification.$": "$.GlobalInput.execution_identification",
                "tenant_identification.$": "$.GlobalInput.tenant_identification",
                "requested_by.$": "$.GlobalInput.requested_by"
              }
            },
            "OutputPath": "$.Payload",
            "End": true
          },
          "SkipChunk": {
            "Type": "Pass",
            "Result": {
              "skipped": true
            },
            "End": true
          }
        }
      },
      "Next": "AggregateStep"
    },
    "AggregateStep": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:000000000000:function:gto-logic",
        "Payload": {
          "mode": "aggregate",
          "customer_tenant_system_name.$": "$.customer_tenant_system_name",
          "output_files.$": "$.ProcessResults[*].output_file",
          "uds_long_token.$": "$.PrepareResult.Payload.uds_long_token",
          "execution_identification.$": "$.execution_identification",
          "tenant_identification.$": "$.tenant_identification",
          "requested_by.$": "$.requested_by"
        }
      },
      "ResultPath": "$.AggregateResult",
      "Next": "FinalSummary"
    },
    "FinalSummary": {
      "Type": "Pass",
      "Parameters": {
        "Step1_Prepare": {
            "RequestVariables": {
                "customer_tenant_system_name.$": "$.customer_tenant_system_name",
                "execution_identification.$": "$.execution_identification",
                "tenant_identification.$": "$.tenant_identification",
                "requested_by.$": "$.requested_by",
                "chunk_size.$": "$.chunk_size",
                "type.$": "$.type"
            },
            "LambdaOutput.$": "$.PrepareResult.Payload"
        },
        "Step2_Process": {
            "RequestVariables": {
                "customer_tenant_system_name.$": "$.customer_tenant_system_name",
                "execution_identification.$": "$.execution_identification",
                "tenant_identification.$": "$.tenant_identification",
                "requested_by.$": "$.requested_by",
                "type.$": "$.type"
            },
            "LambdaOutput (Array).$": "$.ProcessResults"
        },
        "Step3_Aggregate": {
            "RequestVariables": {
                "customer_tenant_system_name.$": "$.customer_tenant_system_name",
                "execution_identification.$": "$.execution_identification",
                "tenant_identification.$": "$.tenant_identification",
                "requested_by.$": "$.requested_by"
            },
            "LambdaOutput.$": "$.AggregateResult.Payload"
        }
      },
      "End": true
    }
  }
}